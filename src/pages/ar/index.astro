---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ExplodedCoupling from '../../components/ExplodedCoupling.astro';

/**
 * DRAFT: the Arabic below is a machine-written draft Sam asked for, applied
 * from docs/ar-copy.json by scripts/apply-ar-copy.mjs. It is not approved and
 * must not deploy — D19 applies here exactly as on Sefer Studio's own site,
 * and scripts/check-copy-status.mjs fails until a person has written the real
 * copy and _STATUS reads APPROVED. Edit the JSON, never this file, and re-run
 * the script: Arabic moves file to file, never through a terminal.
 *
 * `transition:name` values below MUST stay identical to their counterpart in
 * ../index.astro — that pairing is what makes the language-switch transition
 * (work-artefacts-plan.md §6.1) mirror the layout instead of cross-fading
 * unrelated elements. Keep both files' transition names in lockstep when
 * either one's structure changes.
 */
const ph = (en: string) => en;
---
<BaseLayout
  lang="ar"
  title="[PENDING ARABIC] Mera"
  description="[PENDING ARABIC]"
>
  <Header lang="ar" />

  <main>
    <section class="hero container pending">
      <p class="hero__eyebrow" transition:name="hero-eyebrow">{'مكوّنات هيدروليكية، من تركيا إلى الخليج'}</p>
      <h1 transition:name="hero-heading">{'قطع تُنفَّذ ضمن التفاوت المطلوب، وبلغة يقرؤها مشتريك.'}</h1>
      <p class="hero__sub" transition:name="hero-sub">
        {'تُصنّع ميرا الأسطوانات والصمامات والوصلات الهيدروليكية لمصنّعي المعدات في أنحاء الخليج. رسم يدخل، وقطعة مختبَرة تخرج — وموقع يقرؤه المشتري العربي بالعربية، لا كترجمة عن الإنجليزية.'}
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#contact" transition:name="hero-cta-primary">{'أرسل الرسم'}</a>
        <a class="button button--ghost" href="#capabilities" transition:name="hero-cta-ghost">{'شاهد الورشة'}</a>
      </div>
    </section>

    <section class="section container pending">
      <div class="section__head">
        <div>
          <p class="section__kicker" transition:name="kicker-shop">{'الورشة'}</p>
          <h2 transition:name="heading-shop">{'ورشة تصنيع، لا مكتب مبيعات.'}</h2>
        </div>
      </div>
      <p class="section__lead" transition:name="lead-shop">{'تُدير ميرا خراطة وتفريزًا بالتحكم الرقمي لمكوّنات هيدروليكية: أسطوانات وصمامات ووصلات وما بينها من تجهيزات. تصل الرسومات مطبوعة أو بصيغة DWG، وتخرج القطع معبّأة للحاوية، لا لرفٍّ قريب.'}</p>
    </section>

    <ExplodedCoupling />

    <section id="capabilities" class="section container pending">
      <div class="section__head">
        <div>
          <p class="section__kicker" transition:name="kicker-capabilities">{'الإمكانات'}</p>
          <h2 transition:name="heading-capabilities">{'ما الذي يحدث للرسم بعد أن يصل إلينا.'}</h2>
        </div>
      </div>
      <div class="grid grid--4">
        <div class="card" transition:name="card-1">
          <p class="card__index">01</p>
          <h3>{'خراطة وتفريز بالتحكم الرقمي'}</h3>
          <p>{'قضبان وكتل خام تُقطَع وفق الرسم على مكائن متعددة المحاور — قطعة واحدة أو دفعات متكرّرة، على الورشة نفسها.'}</p>
        </div>
        <div class="card" transition:name="card-2">
          <p class="card__index">02</p>
          <h3>{'التجميع'}</h3>
          <p>{'تُبنى الأسطوانات وأجسام الصمامات وتُركَّب لدينا، لا تُسنَد إلى الباطن ثم يُعاد تجميعها على الثقة.'}</p>
        </div>
        <div class="card" transition:name="card-3">
          <p class="card__index">03</p>
          <h3>{'اختبار الضغط'}</h3>
          <p>{'تُختبر كل مجموعة هيدروليكية قبل تعبئتها، لا بالعيّنة بعد شحن الدفعة.'}</p>
        </div>
        <div class="card" transition:name="card-4">
          <p class="card__index">04</p>
          <h3>{'تعبئة التصدير'}</h3>
          <p>{'تُصندَق للشحن البحري إلى ميناء خليجي، لا تُكيَّف لاحقًا عن تعبئة محلية.'}</p>
        </div>
      </div>
    </section>

    <section id="range" class="section container pending">
      <div class="section__head">
        <div>
          <p class="section__kicker" transition:name="kicker-range">{'المجموعة'}</p>
          <h2 transition:name="heading-range">{'أربع عائلات، ورشة واحدة.'}</h2>
        </div>
      </div>
      <ul class="range-list">
        <li class="range-list__row" transition:name="range-row-1">
          <span class="range-list__name">{'أسطوانات'}</span>
          <span class="range-list__desc">{'أحادية وثنائية الفعل، تُصنع وفق رسم العميل لا وفق مقاس كتالوج ثابت.'}</span>
        </li>
        <li class="range-list__row" transition:name="range-row-2">
          <span class="range-list__name">{'صمامات'}</span>
          <span class="range-list__desc">{'أجسام صمامات اتجاهية وللتحكم في الضغط، تُخرَّط وتُركَّب لدينا.'}</span>
        </li>
        <li class="range-list__row" transition:name="range-row-3">
          <span class="range-list__name">{'وصلات'}</span>
          <span class="range-list__desc">{'وصلات سريعة الفصل وأخرى لولبية لخطوط هيدروليكية تحت الضغط.'}</span>
        </li>
        <li class="range-list__row" transition:name="range-row-4">
          <span class="range-list__name">{'موانع تسرّب وتجهيزات'}</span>
          <span class="range-list__desc">{'القطع التي بين القطع — تُورَّد مطابقة، لا تُترك للمشتري ليؤمّنها بنفسه.'}</span>
        </li>
      </ul>
    </section>

    <section id="export" class="section container pending">
      <div class="section__head">
        <div>
          <p class="section__kicker" transition:name="kicker-export">{'التصدير'}</p>
          <h2 transition:name="heading-export">{'مبني لمشترٍ يقرأ العربية، لا مترجَم له.'}</h2>
        </div>
      </div>
      <ul class="export-points">
        <li transition:name="export-point-1">
          <strong>{'جهة تواصل واحدة، بالعربية والإنجليزية'}</strong>
          <span>{'الرسم الذي يصل بالعربية يُقرأ بالعربية، لا يُمرَّر على مترجم أولًا.'}</span>
        </li>
        <li transition:name="export-point-2">
          <strong>{'تسعير لكل رسم'}</strong>
          <span>{'لا قائمة أسعار كتالوجية. كل عرض سعر يُحدَّد وفق الرسم وحجم الدفعة.'}</span>
        </li>
        <li transition:name="export-point-3">
          <strong>{'معبّأة للرحلة'}</strong>
          <span>{'تُصندَق وتُوثَّق للشحن البحري إلى ميناء خليجي من أول دفعة، لا تُكيَّف لاحقًا.'}</span>
        </li>
      </ul>
    </section>

    <section id="contact" class="section contact pending">
      <div class="container">
        <p class="section__kicker" transition:name="kicker-contact">{'تواصل'}</p>
        <h2 transition:name="heading-contact">{'أرسل الرسم.'}</h2>
        <p class="section__lead" transition:name="lead-contact">{'رسم مطبوع، أو ملف DWG، أو قطعة لقياسها عكسيًا — يكفي ذلك لبدء عرض السعر.'}</p>
        <div class="contact-card" transition:name="contact-card">
          <span>hello@mera.works</span>
          <p class="contact-card__note">{'تُحدَّد عروض الأسعار وفق كل رسم. لا تسعير كتالوجي.'}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <span lang="en" transition:name="footer-note">Mera — a concept project, Sefer Studio's own brief.</span>
      <span transition:name="footer-credit"><a href="https://seferstudio.com">Built by Sefer Studio</a></span>
    </div>
  </footer>
</BaseLayout>

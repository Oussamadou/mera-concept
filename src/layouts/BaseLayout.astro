---
interface Props {
  lang: 'en' | 'ar';
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2314181c'/%3E%3Ccircle cx='24' cy='24' r='4' fill='%23b8874a'/%3E%3Cpath d='M6 24V8h4l6 10 6-10h4v16h-4V15l-6 9-6-9v9z' fill='%23f5f3ee'/%3E%3C/svg%3E"
    />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <!-- Loaded non-render-blocking: preload the stylesheet, then swap its
         media to `all` once it arrives. Firefox 152/stable and iOS Safari
         both understand `media="print" onload="this.media='all'"`; the
         `<noscript>` fallback covers JS-disabled agents. -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Sans+Arabic:wght@400;600&display=swap"
      />
    </noscript>
    <ClientRouter />
  </head>
  <body>
    <slot />
  
  <script>
    import Lenis from 'lenis';
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    gsap.registerPlugin(ScrollTrigger);

    const lenis = new Lenis({
      duration: 1.2,
      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true
    });

    lenis.on('scroll', ScrollTrigger.update);

    gsap.ticker.add((time) => {
      lenis.raf(time * 1000);
    });
    gsap.ticker.lagSmoothing(0, 0);
  </script>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    
    // Use transition lifecycle events since we use Astro ClientRouter
    document.addEventListener('astro:page-load', () => {
      gsap.registerPlugin(ScrollTrigger);

      const cards = gsap.utils.toArray('.card');
      if (cards.length) {
        gsap.from(cards, {
          scrollTrigger: {
            trigger: '.grid--4',
            start: 'top 85%',
          },
          y: 40,
          opacity: 0,
          duration: 0.8,
          stagger: 0.1,
          ease: 'power3.out'
        });
      }

      const rows = gsap.utils.toArray('.range-list__row');
      if (rows.length) {
        gsap.from(rows, {
          scrollTrigger: {
            trigger: '.range-list',
            start: 'top 85%',
          },
          x: -20,
          opacity: 0,
          duration: 0.6,
          stagger: 0.1,
          ease: 'power2.out'
        });
      }
    });
  </script>
</body>
</html>
